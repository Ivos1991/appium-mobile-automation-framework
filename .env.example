APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/
APPIUM_COMMAND=appium
APPIUM_MANAGED_SERVICE=true
ANDROID_AUTOMATION_NAME=UiAutomator2
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=
ANDROID_SDK_ROOT=tools/android-sdk
ANDROID_HOME=tools/android-sdk
ANDROID_USER_HOME=artifacts/android-user-home
ANDROID_APP_PATH=apps/android/wdio-demo-app.apk
ANDROID_APP_PACKAGE=com.wdiodemoapp
ANDROID_APP_ACTIVITY=com.wdiodemoapp.MainActivity
ANDROID_APP_WAIT_ACTIVITY=com.wdiodemoapp.MainActivity
DEFAULT_TIMEOUT_MS=15000
STEP_TIMEOUT_MS=60000
CONNECTION_RETRY_TIMEOUT_MS=120000
CONNECTION_RETRY_COUNT=3
NEW_COMMAND_TIMEOUT_SECONDS=240
